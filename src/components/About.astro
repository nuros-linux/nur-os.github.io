---
import { useTranslations, getLangFromUrl, type Lang } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
---

<section id="about" class="bento-tile tile-about">
  <h2 class="tile-title headline-small">{t('about.title')}</h2>
  <p class="tile-text body-large">{t('about.p1')}</p>
</section>

<style>
  .tile-about {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .tile-title { color: var(--md-on-surface); margin-bottom: var(--spacing-sm); }
  .tile-text { color: var(--md-on-surface-variant); }
</style>
