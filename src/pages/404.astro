---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<MainLayout title="404 — NurOS" description="Page not found">
  <div class="nuros-app">
    <Header />
    <main id="main-content" class="not-found">
      <div class="container">
        <div class="not-found-inner">
          <p class="code display-large">404</p>
          <h1 class="title headline-medium">Page not found</h1>
          <p class="desc body-large">
            The page you're looking for doesn't exist or has been moved.
          </p>
          <div class="actions">
            <a href="/" class="btn">Go home</a>
            <a href="/blog" class="btn btn-outline">Blog</a>
          </div>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</MainLayout>

<style>
  .nuros-app { min-height: 100vh; display: flex; flex-direction: column; }

  .not-found {
    flex: 1;
    display: flex;
    align-items: center;
    padding: var(--spacing-xl) 0;
  }

  .not-found-inner {
    text-align: center;
    max-width: 480px;
    margin: 0 auto;
  }

  .code {
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--md-primary);
    margin-bottom: 0.25rem;
    user-select: none;
  }

  .title {
    color: var(--md-on-surface);
    margin-bottom: var(--spacing-sm);
  }

  .desc {
    color: var(--md-on-surface-variant);
    margin-bottom: var(--spacing-md);
  }

  .actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>
