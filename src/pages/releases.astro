---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, getLangFromUrl, downloadEditions, type Lang } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
---

<MainLayout title={`${t('download.title')} — NurOS`} description={t('download.subtitle')}>
  <div class="nuros-app">
    <Header />
    <main id="main-content" class="dl-page">
      <div class="container">

        <div class="dl-header">
          <span class="rolling-badge label-medium">{t('download.rolling')}</span>
          <h1 class="dl-title display-small">{t('download.title')}</h1>
          <p class="dl-sub body-large">{t('download.subtitle')}</p>
        </div>

        {downloadEditions.map((edition) => (
          <section class="edition">
            <div class="edition-head">
              <div class="edition-name-row">
                <h2 class="edition-name headline-small">{edition.id === 'juldyz' ? 'Juldyz' : 'Josh'}</h2>
                <span class={`edition-badge label-small ${edition.id}`}>
                  {t(edition.id === 'juldyz' ? 'download.juldyz.label' : 'download.josh.label')}
                </span>
              </div>
              <p class="edition-desc body-medium">
                {t(edition.id === 'juldyz' ? 'download.juldyz.desc' : 'download.josh.desc')}
              </p>
            </div>

            <div class="arch-grid">
              {edition.arches.map((arch) => (
                <div class="arch-card">
                  <span class="arch-name label-large">{arch.name}</span>
                  {arch.link ? (
                    <a href={arch.link} class="btn btn-sm arch-btn--get" target="_blank" rel="noopener"
                       aria-label={`${t('download.get')} NurOS ${edition.id === 'juldyz' ? 'Juldyz' : 'Josh'} — ${arch.name}`}>
                      {t('download.get')}
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    </a>
                  ) : (
                    <span class="arch-btn arch-btn--soon label-small">{t('download.soon')}</span>
                  )}
                </div>
              ))}
            </div>
          </section>
        ))}

        <p class="dl-note body-small">{t('download.note')}</p>

      </div>
    </main>
    <Footer />
  </div>
</MainLayout>

<style>
  .nuros-app { min-height: 100vh; display: flex; flex-direction: column; }
  .dl-page { flex: 1; padding: var(--spacing-xl) 0; }

  .dl-header { text-align: center; margin-bottom: var(--spacing-lg); }

  .rolling-badge {
    display: inline-block;
    text-transform: uppercase;
    padding: 0.2rem 0.7rem;
    border-radius: var(--shape-full);
    border: 1px solid var(--md-outline);
    color: var(--md-primary);
    margin-bottom: 0.75rem;
  }

  .dl-title {
    color: var(--md-on-surface);
    margin-bottom: 0.5rem;
  }

  .dl-sub {
    color: var(--md-on-surface-variant);
  }

  .edition {
    margin-bottom: var(--spacing-lg);
  }

  .edition-head {
    margin-bottom: var(--spacing-md);
  }

  .edition-name-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .edition-name {
    color: var(--md-on-surface);
  }

  .edition-badge {
    text-transform: uppercase;
    padding: 0.2rem 0.65rem;
    border-radius: var(--shape-full);
  }
  .edition-badge.juldyz {
    background: var(--md-secondary-container);
    color: var(--md-on-secondary-container);
  }
  .edition-badge.josh {
    background: var(--md-tertiary-container);
    color: var(--md-on-tertiary-container);
  }

  .edition-desc {
    color: var(--md-on-surface-variant);
    max-width: 540px;
  }

  .arch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
  }

  .arch-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    background: var(--md-surface-container);
    border-radius: var(--shape-lg-increased);
    box-shadow: var(--elevation-0);
    transition: box-shadow var(--motion-medium-1) var(--easing-standard), background-color var(--motion-medium-1) var(--easing-standard);
  }
  .arch-card:hover { box-shadow: var(--elevation-1); background-color: var(--md-surface-container-high); }

  .arch-name {
    color: var(--md-on-surface);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: 'SF Mono', 'Fira Mono', monospace;
  }

  .arch-btn--soon {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    height: 2rem;
    padding: 0 1rem;
    border-radius: var(--shape-full);
    background: var(--md-surface-container-high);
    border: 1px solid var(--md-outline-variant);
    color: var(--md-on-surface-variant);
    cursor: default;
    white-space: nowrap;
  }

  .dl-note {
    text-align: center;
    color: var(--md-on-surface-variant);
    margin-top: var(--spacing-md);
    padding-top: var(--spacing-md);
    border-top: var(--border);
  }

  @media (max-width: 480px) {
    .arch-grid { grid-template-columns: 1fr; }
  }
</style>
