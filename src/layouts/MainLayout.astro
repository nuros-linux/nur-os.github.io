---
import '../styles/global.css';
import { getLangFromUrl } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'NurOS',
  description = 'Independent Linux Distribution',
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1215" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&family=Noto+Sans:wght@400;500;600;700&display=swap" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
    <script is:inline src="https://keepandroidopen.org/banner.js?size=minimal&animation=off"></script>
    <style is:global>
      .kao-banner {
        position: fixed !important;
        top: 0 !important;
        left: 0;
        right: 0;
        width: 100%;
        z-index: 1100;
      }
    </style>
    <script is:inline>
      (function () {
        var observed = null;

        function bannerVisible(banner) {
          return banner &&
            banner.offsetParent !== null &&
            getComputedStyle(banner).display !== 'none';
        }

        function adjustHeader() {
          var header = document.querySelector('header');
          if (!header) return;
          var banner = document.querySelector('.kao-banner');
          var bannerH = bannerVisible(banner) ? banner.offsetHeight : 0;
          header.style.top = bannerH + 'px';
          document.body.style.paddingTop = (bannerH + header.offsetHeight) + 'px';

          if (banner && observed !== banner) {
            observed = banner;
            new MutationObserver(adjustHeader).observe(banner, {
              attributes: true,
              attributeFilter: ['style', 'class'],
            });
            if (window.ResizeObserver) new ResizeObserver(adjustHeader).observe(banner);
          }
        }

        var tries = 0;
        var poll = setInterval(function () {
          adjustHeader();
          if (document.querySelector('.kao-banner') || ++tries > 40) clearInterval(poll);
        }, 100);

        window.addEventListener('load', adjustHeader);
        window.addEventListener('resize', adjustHeader);
      })();
    </script>
  </body>
</html>
