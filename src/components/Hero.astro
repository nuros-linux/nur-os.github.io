---
import { useTranslations, getLangFromUrl, type Lang } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
---

<section id="home" class="hero">
  <div class="container">
    <div class="hero-content">
      <h1 class="hero-title display-medium emphasized">NurOS</h1>
      <p class="hero-subtitle body-large">{t('hero.subtitle')}</p>
      <div class="cta-buttons">
        <a href={lang !== "en" ? `/${lang}/releases` : '/releases'} class="btn btn-lg hero-btn">{t('hero.cta')}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 88vh;
    padding: var(--spacing-xl) 0 var(--spacing-lg);
    display: flex;
    align-items: center;
    background-color: var(--md-surface);
    position: relative;
  }

  .hero-content {
    max-width: 680px;
    text-align: center;
    margin: 0 auto;
  }

  .hero-title {
    margin-bottom: var(--spacing-sm);
    color: var(--md-on-surface);
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    margin-bottom: var(--spacing-md);
    color: var(--md-on-surface-variant);
  }

  .hero-btn {
    box-shadow: var(--elevation-2);
  }
  .hero-btn:hover { box-shadow: var(--elevation-3); }

  @media (max-width: 576px) {
    .hero-title { font-size: 2.25rem; line-height: 2.75rem; }
  }
</style>
