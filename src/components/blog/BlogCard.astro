---
import { useTranslations, getLangFromUrl, type Lang } from '../../i18n/ui';

interface Props {
  slug: string;
  title: string;
  description?: string;
  publishedAt?: Date;
  author?: string;
  tags?: string[];
  lang?: Lang;
}

const { slug, title, description, publishedAt, author, tags = [], lang: propLang } = Astro.props;
const lang = propLang ?? (getLangFromUrl(Astro.url) as Lang);
const t = useTranslations(lang);
const blogBase = lang === 'ru' ? '/ru/blog' : lang === 'kz' ? '/kz/blog' : '/blog';

const dateLocale = lang === 'ru' ? 'ru-RU' : lang === 'kz' ? 'kk-KZ' : 'en-US';
const dateStr = publishedAt
  ? publishedAt.toLocaleDateString(dateLocale, {
      year: 'numeric', month: 'long', day: 'numeric',
    })
  : null;
---

<article class="blog-card">
  <div class="card-body">
    {tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => <span class="tag label-small">{tag}</span>)}
      </div>
    )}
    <h2 class="card-title title-large">
      <a href={`${blogBase}/${slug}`} aria-label={title}>{title}</a>
    </h2>
    {description && <p class="card-desc body-medium">{description}</p>}
  </div>
  <div class="card-footer label-medium">
    {author && <span class="author">{author}</span>}
    {dateStr && <time datetime={publishedAt?.toISOString()}>{dateStr}</time>}
    <a href={`${blogBase}/${slug}`} class="read-more" aria-hidden="true" tabindex="-1">{t('blog.read')}</a>
  </div>
</article>

<style>
  .blog-card { background-color: var(--md-surface-container); border-radius: var(--shape-lg-increased); box-shadow: var(--elevation-0); display: flex; flex-direction: column; transition: box-shadow var(--motion-medium-1) var(--easing-standard), background-color var(--motion-medium-1) var(--easing-standard), border-radius var(--motion-medium-2) var(--easing-spring); }
  .blog-card:hover { box-shadow: var(--elevation-2); background-color: var(--md-surface-container-high); border-radius: var(--shape-xl-increased); }
  .card-body { padding: var(--spacing-md); flex: 1; }
  .tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: var(--spacing-sm); }
  .tag { padding: .25rem .7rem; background-color: var(--md-secondary-container); color: var(--md-on-secondary-container); border-radius: var(--shape-full); }
  .card-title { margin-bottom: var(--spacing-xs); }
  .card-title a { color: var(--md-on-surface); transition: color var(--motion-medium-1) var(--easing-standard); }
  .card-title a:hover { color: var(--md-primary); opacity: 1; }
  .card-desc { color: var(--md-on-surface-variant); }
  .card-footer { display: flex; align-items: center; gap: var(--spacing-sm); padding: var(--spacing-sm) var(--spacing-md); border-top: 1px solid var(--md-outline-variant); color: var(--md-on-surface-variant); }
  .author { flex: 1; color: var(--md-primary); }
  .read-more { color: var(--md-primary); white-space: nowrap; opacity: 1; }
  .read-more:hover { opacity: .85; }
</style>
