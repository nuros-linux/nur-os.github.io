---
import { useTranslations, getLangFromUrl, teamData, type Lang } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const members = teamData[lang];
---

<section id="team" class="team">
  <div class="container">
    <h2 class="section-title headline-small">{t('team.title')}</h2>
    <div class="team-grid">
      {members.map((m) => (
        <div class="team-member">
          <h3 class="title-medium">{m.name}</h3>
          <p class="role label-large">{m.role}</p>
          {m.skills && <p class="skills body-small">{m.skills}</p>}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .team { padding: var(--spacing-xl) 0; background-color: var(--md-surface); }
  .team-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px,1fr)); gap: var(--spacing-md); }
  .team-member { padding: var(--spacing-md); border-radius: var(--shape-lg-increased); background-color: var(--md-surface-container); box-shadow: var(--elevation-0); transition: box-shadow var(--motion-medium-1) var(--easing-standard), background-color var(--motion-medium-1) var(--easing-standard), border-radius var(--motion-medium-2) var(--easing-spring); }
  .team-member:hover { box-shadow: var(--elevation-2); background-color: var(--md-surface-container-high); border-radius: var(--shape-xl-increased); }
  .team-member h3 { margin-bottom: var(--spacing-xs); color: var(--md-primary); }
  .team-member .role { margin-bottom: var(--spacing-xs); color: var(--md-on-surface); }
  .team-member .skills { color: var(--md-on-surface-variant); }
  @media (max-width: 576px) { .team-grid { grid-template-columns: 1fr; } }
</style>
