---
import { useTranslations, getLangFromUrl, type Lang } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
---

<section id="contact" class="contact">
  <div class="container">
    <div class="cta-card">
      <h2 class="cta-title headline-small">{t('contact.title')}</h2>
      <p class="cta-desc body-large">{t('contact.desc')}</p>
      <a href="https://become.nuros.org/" class="btn btn-tonal" target="_blank" rel="noopener">
        {t('contact.form')}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .contact { padding: var(--spacing-xl) 0; }

  .cta-card {
    text-align: center;
    padding: var(--spacing-xl) var(--spacing-lg);
    border-radius: var(--shape-xl-increased);
    background: var(--md-primary-container);
    box-shadow: var(--elevation-2);
    max-width: 560px;
    margin: 0 auto;
  }

  .cta-title {
    color: var(--md-on-primary-container);
    margin-bottom: var(--spacing-sm);
  }

  .cta-desc {
    color: var(--md-on-primary-container);
    opacity: 0.85;
    margin-bottom: var(--spacing-md);
  }
</style>
