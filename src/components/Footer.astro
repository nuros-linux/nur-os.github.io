---
import { useTranslations, getLangFromUrl, type Lang } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
---

<footer>
  <div class="container">
    <div class="footer-content">
      <p class="body-small">{t('footer.license')}</p>
      <p class="body-small"><a href="https://nuros.org" target="_blank" rel="noopener">nuros.org</a></p>
    </div>
  </div>
</footer>

<style>
  footer { padding: var(--spacing-md) 0; border-top: var(--border); background-color: var(--md-surface-container-low); }
  .footer-content { display: flex; justify-content: space-between; align-items: center; }
  .footer-content p { color: var(--md-on-surface-variant); }
  .footer-content a { color: var(--md-primary); }
  @media (max-width: 768px) { .footer-content { flex-direction: column; gap: 0.5rem; text-align: center; } }
</style>
