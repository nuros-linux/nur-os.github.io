---
import BlogLayout from '../../layouts/BlogLayout.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLangFromUrl, type Lang } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);

const allPosts = await getCollection(`posts-${lang}`);
const posts = allPosts
  .filter((p) => p.data.publishedAt)
  .sort((a, b) => b.data.publishedAt!.getTime() - a.data.publishedAt!.getTime());
---

<BlogLayout title=`${t('blog.title')} - NurOS` description=`${t('blog.description')}`>
  <section class="blog-section">
    <div class="container">
      <h1 class="section-title">{t('blog.title')}</h1>
      {posts.length === 0 ? (
        <div class="empty"><p>{t('blog.empty')}</p></div>
      ) : (
        <div class="posts-grid">
          {posts.map((post) => (
            <BlogCard
              slug={post.id}
              title={post.data.title}
              description={post.data.description}
              publishedAt={post.data.publishedAt}
              author={post.data.author}
              tags={post.data.tags}
              lang={lang}
            />
          ))}
        </div>
      )}
    </div>
  </section>
</BlogLayout>

<style>
  .blog-section { padding: var(--spacing-xl) 0; min-height: 60vh; }
  .posts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px,1fr)); gap: var(--spacing-md); }
  .empty { text-align: center; padding: var(--spacing-xl) 0; color: var(--md-on-surface-variant); font-size: 1.1rem; }
  @media (max-width: 576px) { .posts-grid { grid-template-columns: 1fr; } }
</style>
